    {
      method: "POST",
      headers: { "Content-Type": "application/json", "x-client-type": "web" },
      credentials: "include",
    },
  );

  if (!refreshResponse.ok) {
    return null;
  }

  const response = await fetch(`${BASE_URL}/users/me`, {
    method: "GET",
    headers: { "Content-Type": "application/json", "x-client-type": "web" },
    credentials: "include",
  });

  const data = await response.json();
  return data;
