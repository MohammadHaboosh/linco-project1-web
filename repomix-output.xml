      >
        <div className={styles["icon-wrapper"]}>
          <IoLogOutOutline className={styles.icon} />
        </div>
        {isOpen && <span className={styles.text}>Log out</span>}
      </div>
    </aside>
  );
};

export default Sidebar;
</file>

