          </div>
          <div className={styles["dept-list"]}>
            {availableDepartments.map((dept) => (
              <div
                key={dept.id}
                className={`${styles["dept-item"]} ${dept.active ? styles["active"] : ""}`}
                onClick={() => setIsDeptOpen(false)}
              >
                <span>{dept.name}</span>
                {dept.active && (
                  <IoCheckmarkCircle className={styles["check-icon"]} />
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
};

