<file path="src/features/LandingPage/LandingPage.module.css">
.landingContainer {
  width: 100%;
  background-color: var(--color-linco-bg);
  font-family: var(--font-sans);
  overflow-x: hidden;
}

.landingNav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  background: transparent;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 100;
  box-sizing: border-box;
}
.navLinks {
  display: flex;
  gap: 30px;
}
.navLinks a {
  color: #ffffff;
  text-decoration: none;
  font-weight: 500;
  transition: opacity 0.2s;
}
.navLinks a:hover {
  opacity: 0.7;
}
.navActions {
  display: flex;
  gap: 15px;
}

.btnPrimary,
.btnOutline,
.btnSecondary {
  padding: 10px 24px;
  border-radius: 30px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
}
.btnPrimary {
  background-color: var(--color-white);
  color: var(--color-linco-navy);
  border: none;
}
.btnOutline {
  background-color: transparent;
  border: 1px solid var(--color-white);
  color: var(--color-white);
}
.btnSecondary {
  background-color: var(--color-linco-blue);
  color: var(--color-white);
  border: none;
}
.btnPrimary:hover,
.btnSecondary:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.heroSection {
  position: relative;
  padding: 160px 60px 100px;
  color: white;
  min-height: 85vh;
  display: flex;
  align-items: center;
}
.heroContent {
  display: flex;
  align-items: center;
  gap: 50px;
  max-width: 1400px;
  margin: 0 auto;
  z-index: 10;
  width: 100%;
}
.heroText {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.heroBrandHeader {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 35px;
}

.heroMascot {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  object-fit: cover;
  background-color: #ffffff;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  border: 3px solid #47bfff;
}

.heroBrandTitles {
  display: flex;
  flex-direction: column;
}

.heroBrandTitles h1 {
  font-size: 3.2rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 5px 0;
  line-height: 1;
}

.heroBrandTitles span {
  font-size: 1.6rem;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5px;
}

.heroSubTitle {
  font-size: 1.5rem;
  font-weight: 700;
  color: #47bfff;
  margin: 0 0 15px 0;
}

.heroDesc {
  font-size: 1.05rem;
  color: #cbd5e1;
  line-height: 1.6;
  max-width: 520px;
  margin: 0 0 30px 0;
}
.heroText h1 {
  font-size: 3.5rem;
  font-weight: 800;
  margin-bottom: 20px;
  line-height: 1.2;
}
.heroText p {
  font-size: 1.1rem;
  color: var(--color-linco-light);
  margin-bottom: 30px;
  line-height: 1.6;
  max-width: 500px;
}
.heroImages {
  flex: 1;
  position: relative;
  height: 400px;
}

.section {
  padding: 100px 60px;
  max-width: 1400px;
  margin: 0 auto;
}
.sectionTitle {
  text-align: center;
  color: var(--color-linco-navy);
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 15px;
}
.sectionSubtitle {
  text-align: center;
  color: var(--color-slate-500);
  font-size: 1.1rem;
  margin-bottom: 50px;
}

.infoRow {
  display: flex;
  align-items: center;
  gap: 60px;
  margin-bottom: 80px;
}
.infoRowReverse {
  flex-direction: row-reverse;
}
.infoText {
  flex: 1;
}
.infoText h3 {
  font-size: 1.8rem;
  color: var(--color-linco-navy);
  font-weight: 800;
  margin-bottom: 15px;
}
.infoText p {
  color: var(--color-slate-600);
  line-height: 1.6;
  margin-bottom: 20px;
}
.checkList {
  list-style: none;
  padding: 0;
  margin: 0 0 25px 0;
}
.checkList li {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  color: var(--color-linco-navy);
  font-weight: 600;
}
.checkIcon {
  color: var(--color-linco-blue);
  font-size: 1.2rem;
  background: #e0e7ff;
  border-radius: 5px;
  padding: 2px;
}
.infoImage {
  flex: 1;
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(17, 41, 80, 0.1);
  overflow: hidden;
}
.infoImage img {
  width: 100%;
  height: auto;
  display: block;
}
.footerContainer {
  margin-top: 0;
}
.heroImg {
  width: 100%;
  height: auto;
  max-height: 550px;
  object-fit: contain;
  filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.2));
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-20px);
  }
  100% {
    transform: translateY(0px);
  }
}

.featureImg {
  width: 100%;
  height: 100%;
  min-height: 350px;
  object-fit: cover;
  border-radius: 20px;
  transition: transform 0.5s ease;
}

.infoRow:hover .featureImg {
  transform: scale(1.03);
}
.navBrandText {
  color: var(--color-linco-light);
  margin: 0;
  font-weight: 800;
  font-size: 1.6rem;
  letter-spacing: 0.5px;
}

.heroComposition {
  position: relative;
  width: 100%;
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compLayer1 {
  position: absolute;
  width: 75%;
  left: 0%;
  top: 10%;
  z-index: 1;
  border-radius: 16px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  animation: floatSlow 8s ease-in-out infinite;
}

.compLayer2 {
  position: absolute;
  width: 65%;
  right: -10%;
  top: -5%;
  z-index: 2;
  border-radius: 12px;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
  /* أضفنا تأخير 0.5 ثانية لكي لا تتحرك مع الخلفية بنفس اللحظة */
  animation: floatMedium 6s ease-in-out infinite 0.5s;
}

.compLayer3 {
  position: absolute;
  width: 45%;
  right: -5%;
  bottom: -5%;
  z-index: 3;
  border-radius: 12px;
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.35);
  animation: floatFast 5s ease-in-out infinite 1s;
}

.compLayer4 {
  position: absolute;
  width: 35%;
  left: 5%;
  bottom: 10%;
  z-index: 4;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  animation: floatSuperFast 4s ease-in-out infinite 0.2s;
}

@keyframes floatSlow {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-15px);
  }
}
@keyframes floatMedium {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-25px);
  }
}
@keyframes floatFast {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-35px);
  }
}
@keyframes floatSuperFast {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-20px);
  }
}

@media (max-width: 900px) {
  .heroComposition {
    height: 350px;
  }
  .compLayer1 {
    width: 90%;
    left: 5%;
    top: 20%;
  }
  .compLayer2 {
    width: 70%;
    right: -5%;
    top: 0%;
  }
