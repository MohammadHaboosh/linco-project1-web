import { useState } from "react";
import { useTranslation } from "react-i18next";
import {
  IoArrowBackOutline,
  IoAddCircleOutline,
  IoTrashOutline,
} from "react-icons/io5";
import LessonModal from "./LessonModal";
import styles from "./CourseBuilder.module.css";

const CourseBuilder = ({ onBack }) => {
  const { t } = useTranslation();
  const [course, setCourse] = useState({
    title: "",
    description: "",
    sections: [],
  });
  const [activeModal, setActiveModal] = useState({
    isOpen: false,
    sectionIndex: null,
  });

  const addSection = () => {
    setCourse((prev) => ({
      ...prev,
      sections: [
        ...prev.sections,
        { id: Date.now(), title: "", hasQuiz: false, lessons: [] },
      ],
    }));
  };

  const updateSectionTitle = (index, value) => {
    const newSections = [...course.sections];
    newSections[index].title = value;
    setCourse({ ...course, sections: newSections });
  };

  const saveLesson = (lessonData) => {
    const newSections = [...course.sections];
    newSections[activeModal.sectionIndex].lessons.push({
      ...lessonData,
      id: Date.now(),
    });
    setCourse({ ...course, sections: newSections });
    setActiveModal({ isOpen: false, sectionIndex: null });
  };

  return (
    <div className={styles.builderContainer}>
      <div className={styles.header}>
        <button onClick={onBack} className={styles.backBtn}>
          <IoArrowBackOutline /> {t("back-to-courses")}
        </button>
        <button className={styles.publishBtn}>{t("save-course")}</button>
      </div>

      <div className={styles.builderLayout}>
        <div className={styles.leftCol}>
          <h2 className={styles.builderTitle}>{t("course-builder")}</h2>
          <div className={styles.formGroup}>
            <label>{t("course-title")}</label>
            <input
              type="text"
              value={course.title}
              onChange={(e) => setCourse({ ...course, title: e.target.value })}
              className={styles.input}
            />
          </div>
          <div className={styles.formGroup}>
            <label>{t("course-desc")}</label>
            <textarea
              value={course.description}
              onChange={(e) =>
                setCourse({ ...course, description: e.target.value })
              }
              className={styles.textarea}
            />
          </div>
        </div>

        <div className={styles.rightCol}>
          <div className={styles.sectionsHeader}>
            <h3>Course Curriculum</h3>
            <button onClick={addSection} className={styles.addSectionBtn}>
              <IoAddCircleOutline /> {t("add-section")}
            </button>
          </div>

          {course.sections.map((section, sIdx) => (
            <div key={section.id} className={styles.sectionCard}>
              <input
                type="text"
                value={section.title}
                onChange={(e) => updateSectionTitle(sIdx, e.target.value)}
                placeholder={t("section-title")}
                className={styles.sectionTitleInput}
              />

              <div className={styles.lessonsList}>
                {section.lessons.map((lesson) => (
                  <div key={lesson.id} className={styles.lessonItem}>
                    <span>
                      {lesson.order}. {lesson.title}
                    </span>
                    <span className={styles.lessonDuration}>
                      {lesson.duration}
                    </span>
                  </div>
                ))}
              </div>

              <button
                onClick={() =>
                  setActiveModal({ isOpen: true, sectionIndex: sIdx })
                }
                className={styles.addLessonBtn}
              >
                + {t("add-lesson")}
              </button>
            </div>
          ))}
        </div>
      </div>

      {activeModal.isOpen && (
        <LessonModal
          onClose={() => setActiveModal({ isOpen: false, sectionIndex: null })}
          onSave={saveLesson}
        />
      )}
    </div>
  );
};

export default CourseBuilder;
</file>

