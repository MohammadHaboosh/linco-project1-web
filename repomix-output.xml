.instructions {
  font-size: 0.95rem;
  color: var(--color-slate-500);
  margin-bottom: 32px;
}

.btn-primary {
  width: 100%;
  padding: 14px;
  background: var(--bg-navy-gradient);
  color: var(--color-white);
  border: none;
  border-radius: 30px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
  margin-bottom: 24px;
}

.btn-primary:hover {
  background-color: var(--color-linco-navy-hover);
}

.resend-section {
  margin-bottom: 24px;
  font-size: 0.95rem;
  color: var(--color-slate-500);
}

.btn-text {
  background: none;
  border: none;
  color: var(--color-blue-500);
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  margin-left: 5px;
}

.btn-text:hover {
  text-decoration: underline;
}

.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: none;
  border: none;
  color: var(--color-slate-500);
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.2s;
}

.btn-back:hover {
  color: var(--color-linco-navy);
}

.back-icon {
  margin-right: 8px;
  font-size: 1.1rem;
}
</file>

